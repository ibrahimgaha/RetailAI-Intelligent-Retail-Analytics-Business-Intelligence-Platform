      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{8536D910-AEA5-48A4-BF38-933C897F9523}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tâche d'exécution de requêtes SQL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8E63E12E-CFC2-4256-B8BC-929A38B0CD3E}"
          SQLTask:SqlStatementSource="DECLARE @StartDate DATE = '2020-01-01';&#xA;DECLARE @EndDate DATE = '2030-12-31';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;    INSERT INTO DimDate&#xA;    (&#xA;        DateKey,&#xA;        FullDate,&#xA;        DayNumber,&#xA;        DayName,&#xA;        MonthNumber,&#xA;        MonthName,&#xA;        QuarterNumber,&#xA;        YearNumber,&#xA;        WeekNumber,&#xA;        IsWeekend&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        CONVERT(INT, FORMAT(@StartDate,'yyyyMMdd')),&#xA;        @StartDate,&#xA;        DAY(@StartDate),&#xA;        DATENAME(WEEKDAY,@StartDate),&#xA;        MONTH(@StartDate),&#xA;        DATENAME(MONTH,@StartDate),&#xA;        DATEPART(QUARTER,@StartDate),&#xA;        YEAR(@StartDate),&#xA;        DATEPART(WEEK,@StartDate),&#xA;        CASE&#xA;            WHEN DATENAME(WEEKDAY,@StartDate) IN ('Saturday','Sunday')&#xA;            THEN 1&#xA;            ELSE 0&#xA;        END&#xA;    );&#xA;&#xA;    SET @StartDate = DATEADD(DAY,1,@StartDate);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
